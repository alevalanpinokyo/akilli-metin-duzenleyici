<Window x:Class="AkilliMetinDuzenleyici.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AkilliMetinDuzenleyici.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}"
        Title="Akıllı Metin ve İmla Düzenleyici" 
        Height="760" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Quota Bar -->
            <RowDefinition Height="*"/>    <!-- Main Editors -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER & QUOTA BAR -->
        <Border Grid.Row="0" Background="{StaticResource CardBgBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✨ Akıllı Metin ve İmla Düzenleyici" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <Border Background="#313244" CornerRadius="4" Padding="6,2" Margin="10,2,0,0">
                            <TextBlock Text="v1.0 - Groq Cloud" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Metnin üslup ve anlamını bozmadan imla, noktalama ve yazım hatalarını yapay zeka ile otomatik düzeltin." 
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Quota Tracker Display -->
                <Border Grid.Column="1" Background="{StaticResource CardHeaderBgBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                        CornerRadius="8" Padding="12,6" Margin="16,0,16,0" VerticalAlignment="Center">
                    <StackPanel Width="240">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="📊 Günlük Kota Kullanımı" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding DailyQuotaText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Value="{Binding DailyQuotaPercentage, Mode=OneWay}" Height="6"/>
                        <TextBlock Text="{Binding DailyWordCount, StringFormat='Bugün işlenen: {0:N0} kelime'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- Prompt Selector & Settings Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Prompt Dropdown Selector -->
                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="🎯 Aktif İstem (Prompt):" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding SavedPrompts}" 
                                  SelectedItem="{Binding SelectedPrompt}" 
                                  DisplayMemberPath="Name" 
                                  Width="180" Height="30"/>
                    </StackPanel>

                    <Button Content="⚙ Ayarlar" Style="{StaticResource OutlineButtonStyle}" 
                            Command="{Binding OpenSettingsCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            VerticalAlignment="Bottom" Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN DUAL EDITOR SECTION -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: INPUT TEXT BOX -->
            <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                    CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Input Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📝 Girdi Metni" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="⚡ Örnek Yükle" Style="{StaticResource OutlineButtonStyle}" 
                                    Command="{Binding LoadSampleTextCommand}" Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                            <Button Content="🗑 Temizle" Style="{StaticResource OutlineButtonStyle}" 
                                    Command="{Binding ClearAllCommand}" Padding="8,4" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- Multiline Input Box -->
                    <TextBox Grid.Row="1" Style="{StaticResource ModernTextBoxStyle}" 
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsNotProcessing}"/>

                    <!-- Counter Footer -->
                    <Border Grid.Row="2" Background="{StaticResource CardHeaderBgBrush}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kelime: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding InputWordCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="  |  Tahmini Token: ~" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding InputTokenCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- CENTER ACTION BUTTONS & PROCESSING -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0" Width="110">
                <Button Content="✨ Düzenle" Style="{StaticResource PrimaryAccentButtonStyle}" 
                        Command="{Binding ProcessTextCommand}" Height="46" Margin="0,0,0,8"
                        ToolTip="Metni Groq Cloud AI ile imla ve yazım kurallarına göre düzenle"/>

                <Button Content="⛔ İptal Et" Style="{StaticResource DangerButtonStyle}" 
                        Command="{Binding CancelProcessingCommand}" Height="36"
                        ToolTip="Devam eden düzenleme işlemini iptal et"/>
            </StackPanel>

            <!-- RIGHT PANEL: OUTPUT TEXT BOX -->
            <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                    CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Output Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✅ Düzeltilmiş Metin" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>

                        <Button Content="📋 Kopyala" Style="{StaticResource OutlineButtonStyle}" 
                                Command="{Binding CopyOutputCommand}" HorizontalAlignment="Right" Padding="10,4" FontSize="11"/>
                    </Grid>

                    <!-- Multiline Output Box (Read-Only) -->
                    <TextBox Grid.Row="1" Style="{StaticResource ModernTextBoxStyle}" 
                             Text="{Binding OutputText, Mode=OneWay}" IsReadOnly="True"/>

                    <!-- Counter Footer -->
                    <Border Grid.Row="2" Background="{StaticResource CardHeaderBgBrush}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kelime: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding OutputWordCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="  |  Token: ~" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding OutputTokenCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                CornerRadius="8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📌 Durum: " FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- Progress Bar -->
                <Grid Grid.Column="1" Margin="16,0">
                    <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Value="{Binding ProgressValue, Mode=OneWay}" Height="8" VerticalAlignment="Center"/>
                </Grid>

                <!-- Detail Text -->
                <TextBlock Grid.Column="2" Text="{Binding ProgressDetailText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
