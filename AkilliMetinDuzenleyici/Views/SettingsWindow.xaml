<Window x:Class="AkilliMetinDuzenleyici.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AkilliMetinDuzenleyici.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=True}"
        Title="Groq Cloud API &amp; Uygulama Ayarları"
        Height="720" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙ API ve Özel İstem (Prompt) Ayarları" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
            <TextBlock Text="Groq Cloud API anahtarınızı (gizli) girin, özel sistem istemlerinizi ekleyin ve yönetin." 
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Body Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <!-- API Key Section with Masking & Toggle -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🔑 Groq API Key (Dışarıdan Girilen Anahtar):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource SingleLineInputStyle}" 
                                     Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                     Grid.Column="0" Margin="0,0,8,0"/>
                            <Button Content="{Binding VisibilityToggleText}" Style="{StaticResource OutlineButtonStyle}" 
                                    Command="{Binding ToggleApiKeyVisibilityCommand}" Grid.Column="1" Padding="12,6"/>
                        </Grid>
                        <TextBlock Text="🔒 API Anahtarınız hafızaya kaydolur ve otomatik kırpılır (trimlenir)." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Model & Parameters -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Model Adı:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource SingleLineInputStyle}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Endpoint URL:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource SingleLineInputStyle}" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Temperature Slider -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Yaratıcılık (Temperature - Varsayılan: 0.2):" FontWeight="SemiBold" Grid.Column="0"/>
                    <TextBlock Text="{Binding Temperature, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Grid.Column="1"/>
                </Grid>
                <Slider Minimum="0.0" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" 
                        Value="{Binding Temperature}" Margin="0,0,0,16"/>

                <!-- PROMPT MANAGEMENT SECTION -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="📝 Sistem İstemleri (Prompt Yöneticisi)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,10"/>
                        
                        <!-- Active Prompt Selector -->
                        <TextBlock Text="Aktif Sistem İstemi (Seçin veya Düzenleyin):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding SavedPrompts}" 
                                      SelectedItem="{Binding SelectedPrompt}" 
                                      DisplayMemberPath="Name" 
                                      Height="34" Margin="0,0,8,0"/>
                            <Button Content="🗑 Seçileni Sil" Style="{StaticResource DangerButtonStyle}" 
                                    Command="{Binding DeletePromptCommand}" Grid.Column="1" Padding="10,4"/>
                        </Grid>

                        <!-- System Prompt Content Box -->
                        <TextBlock Text="Aktif İstem Metni (Role &amp; Prompt):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="85" Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <!-- Add New Custom Prompt Box -->
                        <Border Background="{StaticResource CardHeaderBgBrush}" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="➕ Yeni İstem (Prompt) Ekle &amp; Kaydet:" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource SingleLineInputStyle}" Text="{Binding NewPromptName, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="İstem Başlığı (Örn: Akademik Dil Editörü)" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="60" Text="{Binding NewPromptContent, UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="0,0,0,8"/>
                                <Button Content="➕ Yeni İstem Ekle ve Kaydet" Style="{StaticResource PrimaryAccentButtonStyle}" 
                                        Command="{Binding AddNewPromptCommand}" HorizontalAlignment="Right" Padding="14,6"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Chunking Settings -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Parça Limit (Kelime):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource SingleLineInputStyle}" Text="{Binding MaxWordsPerChunk, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Parçalar Arası Bekleme (ms):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource SingleLineInputStyle}" Text="{Binding DelayBetweenChunksMs, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Action Buttons -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button Content="🔄 Varsayılanlara Sıfırla" Style="{StaticResource OutlineButtonStyle}" 
                    Command="{Binding ResetDefaultsCommand}" HorizontalAlignment="Left" Padding="12,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Kaydet ve Kapat" Style="{StaticResource PrimaryAccentButtonStyle}" 
                        Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                        Width="150" Padding="0,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
